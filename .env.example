ANTHROPIC_API_KEY=
SERPAPI_API_KEY=

SERPAPI_TRENDING_NOW_ENABLED=true
SERPAPI_TRENDING_NOW_HOURS=24
SERPAPI_TRENDING_NOW_CATEGORY_ID=7
SERPAPI_TIMEOUT_SECONDS=45
SERPAPI_MAX_RETRIES=3

RESEND_API_KEY=re_...
EMAIL_SENDER=digest@yourdomain.com   # must be a verified Resend sender domain
EMAIL_RECIPIENT=

GITHUB_PIPELINE_TOKEN=
GITHUB_REPOSITORY=Meggers1982/trending-content
GITHUB_PIPELINE_WORKFLOW=run-pipeline.yml
# Workflow dispatched by the dashboard's Scan button when deployed.
GITHUB_RADAR_WORKFLOW=run-radar.yml
GITHUB_PIPELINE_REF=main

RUN_CONTROL_TOKEN=   # optional; if set, POST /api/run requires this value in the x-run-token header
